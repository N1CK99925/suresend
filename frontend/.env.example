# Copy to .env and fill in once your contract is deployed.

# Set to "false" to switch off the localStorage demo and call the
# real Soroban contract through a connected wallet.
VITE_DEMO_MODE=true

VITE_STELLAR_NETWORK=TESTNET
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_SURESEND_CONTRACT_ID=

# Optional: Plausible analytics domain (see docs/ANALYTICS.md)
VITE_PLAUSIBLE_DOMAIN=
